{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ESNext",
		"lib": ["ESNext"],
		"skipLibCheck": true,
		"moduleResolution": "NodeNext",
		"sourceMap": false,
		"rootDir": ".",
		"outDir": "dist",
		"resolveJsonModule": true,

		/* Linting */
		"strict": true,
		"erasableSyntaxOnly": true
	},
	"include": ["src/**/*", "types/**/*", "*.config.ts"],
	"exclude": ["node_modules", "dist"]
}
