{
  "name": "fastify-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path ./src --import tsx ./src/app.ts",
    "build": "tsc -p .",
    "lint": "npx @biomejs/biome check",
    "lint-write": "npx @biomejs/biome check --write",
    "tests": "node --import tsx --test",
    "test:main": "node --import tsx tests/main.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:studio": "npx drizzle-kit studio",
    "db:push": "npx drizzle-kit push",
    "db:pull": "npx drizzle-kit pull",
    "db:check": "npx drizzle-kit check",
    "db:reset": "npx prisma migrate reset"
  },
  "author": "aasenov",
  "license": "MIT",
  "dependencies": {
    "@fastify/compress": "~9.2.0",
    "@fastify/cookie": "~11.1.2",
    "@fastify/cors": "~11.3.0",
    "@fastify/jwt": "~10.2.1",
    "@fastify/multipart": "~10.1.0",
    "@fastify/oauth2": "~8.2.1",
    "@fastify/rate-limit": "~11.2.0",
    "@fastify/schedule": "~7.0.0",
    "@fastify/sse": "~0.6.0",
    "@fastify/static": "~10.1.3",
    "@fastify/swagger": "~9.8.1",
    "@fastify/swagger-ui": "~6.1.1",
    "@fastify/websocket": "~11.3.0",
    "@prisma/adapter-pg": "~7.9.1",
    "croner": "~10.0.1",
    "dotenv": "~17.4.2",
    "drizzle-orm": "~1.0.0-rc.4",
    "fastify": "~5.11.3",
    "handlebars": "~4.7.9",
    "nodemailer": "~9.0.5",
    "pg": "~8.23.0",
    "sanitize-html": "~2.17.6",
    "toad-scheduler": "~4.1.0",
    "undici": "~8.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.7",
    "@types/node": "~26.2.0",
    "@types/nodemailer": "~8.0.1",
    "@types/pg": "~8.21.0",
    "@types/sanitize-html": "~2.16.1",
    "@types/ws": "~8.18.1",
    "drizzle-kit": "~1.0.0-rc.4",
    "json-schema-to-ts": "~3.1.1",
    "tsx": "~4.23.12",
    "typescript": "~7.0.2"
  }
}
