{
  "name": "fastify-server",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "aasenov",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "node --watch-path ./src --import tsx ./src/app.ts",
    "build": "tsc -p .",
    "lint": "tsc --noEmit && oxfmt --write && oxlint --fix",
    "tests": "node --import tsx --test",
    "test:main": "node --import tsx tests/main.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:studio": "npx drizzle-kit studio",
    "db:push": "npx drizzle-kit push",
    "db:pull": "npx drizzle-kit pull",
    "db:check": "npx drizzle-kit check"
  },
  "dependencies": {
    "@fastify/compress": "~9.2.2",
    "@fastify/cookie": "~11.1.3",
    "@fastify/cors": "~11.3.1",
    "@fastify/jwt": "~10.2.4",
    "@fastify/multipart": "~10.1.3",
    "@fastify/oauth2": "~8.3.1",
    "@fastify/rate-limit": "~11.2.1",
    "@fastify/schedule": "~7.0.1",
    "@fastify/sse": "~0.6.1",
    "@fastify/static": "~10.1.6",
    "@fastify/swagger": "~9.8.2",
    "@fastify/swagger-ui": "~6.1.2",
    "@fastify/type-provider-typebox": "~6.3.0",
    "@fastify/websocket": "~11.3.4",
    "croner": "~10.0.1",
    "dotenv": "~18.0.7",
    "drizzle-orm": "~1.0.0-rc.4",
    "fastify": "~5.12.7",
    "handlebars": "~4.7.10",
    "nodemailer": "~10.1.0",
    "pg": "~8.23.1",
    "sanitize-html": "~2.18.0",
    "toad-scheduler": "~4.2.0",
    "typebox": "~1.4.2",
    "undici": "~8.11.2"
  },
  "devDependencies": {
    "@types/node": "~26.6.5",
    "@types/nodemailer": "~8.0.2",
    "@types/pg": "~8.23.1",
    "@types/sanitize-html": "~2.16.2",
    "@types/ws": "~8.18.2",
    "drizzle-kit": "~1.0.0-rc.4",
    "oxfmt": "~0.73.0",
    "oxlint": "~1.88.0",
    "tsx": "~4.23.15",
    "typescript": "~7.0.2"
  }
}
